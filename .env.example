# Copy this file to .env, then fill in your own provider settings.
# Do not share .env or commit it to a repository.

# Required: OpenAI-compatible LLM relay
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

# Required: Doubao TTS
DOUBAO_TTS_PROVIDER=http
DOUBAO_TTS_BASE_URL=
DOUBAO_TTS_API_KEY=
DOUBAO_TTS_APP_ID=
DOUBAO_TTS_ACCESS_KEY=
DOUBAO_TTS_RESOURCE_ID=
DOUBAO_TTS_VOICE_ID=
DOUBAO_TTS_FORMAT=mp3
DOUBAO_TTS_SAMPLE_RATE=24000
DOUBAO_TTS_TIMEOUT_SECONDS=60
DOUBAO_TTS_PAYLOAD_MODE=standard
DOUBAO_TTS_EMOTION_MODE=prefix
DOUBAO_TTS_REFERENCE_MODE=disabled

# Optional: the browser voice-input feature does not require these settings.
STT_PROVIDER=
STT_BASE_URL=
STT_API_KEY=
STT_RESOURCE_ID=
STT_MODEL=
STT_TIMEOUT_SECONDS=60

# Local server
HOST=127.0.0.1
PORT=8001
MAX_AUDIO_BYTES=12000000
