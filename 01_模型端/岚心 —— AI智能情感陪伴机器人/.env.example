# 大模型（OpenAI 兼容接口）
LLM_BASE_URL=https://你的中转站地址/v1
LLM_API_KEY=填写你自己的大模型密钥
LLM_MODEL=填写模型名称
LLM_TIMEOUT_SECONDS=60

# 豆包语音合成
DOUBAO_TTS_PROVIDER=http
DOUBAO_TTS_BASE_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional
DOUBAO_TTS_API_KEY=填写你自己的豆包TTS密钥
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
DOUBAO_TTS_VOICE_ID=填写已开通的音色ID
DOUBAO_TTS_FORMAT=mp3
DOUBAO_TTS_SAMPLE_RATE=24000
DOUBAO_TTS_TIMEOUT_SECONDS=60
DOUBAO_TTS_PAYLOAD_MODE=standard
DOUBAO_TTS_EMOTION_MODE=prefix
DOUBAO_TTS_REFERENCE_MODE=disabled

# 豆包流式语音识别
STT_PROVIDER=doubao_streaming
STT_BASE_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel
STT_API_KEY=填写你自己的豆包语音识别密钥
STT_APP_ID=
STT_ACCESS_KEY=
STT_RESOURCE_ID=volc.seedasr.sauc.duration
STT_MODEL=bigmodel
STT_TIMEOUT_SECONDS=60

# 本地服务。开发板访问时需将 HOST 改为 0.0.0.0
HOST=0.0.0.0
PORT=8001
MAX_AUDIO_BYTES=12000000
